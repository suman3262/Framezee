# ── This deployment ──
# development | staging | production.
# Production refuses to start unless NEXT_PUBLIC_SITE_URL is set and https.
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database (Supabase → Project Settings → Database → Connect) ──
# A password with : / ? # [ ] @ in it must be percent-encoded or the URL truncates.
#
# NEVER use the direct host (db.PROJECT.supabase.co) on a serverless host.
# Supabase direct hosts are IPv6-only and Vercel has no IPv6 egress, so every query
# fails and every page that reads the database returns 500.
#
# Local / long-running server — Session pooler, port 5432:
#   postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Vercel / serverless — Transaction pooler, port 6543 (db/index.ts sets prepare:false for it):
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"

# ── Supabase auth + storage (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server only — never expose to the browser. It bypasses every RLS policy.
# Needed for: creating admins, downloading a customer's artwork, uploading product images.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Fast2SMS — phone OTP, via Supabase's Send SMS Hook ──
# Also set as a Supabase function secret: npx supabase secrets set FAST2SMS_API_KEY=...
FAST2SMS_API_KEY=""

# ── Razorpay (Sprint 6) ──
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ── Shiprocket (Sprint 7) ──
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION="Primary"

# ── Optional ──
# How long an unreferenced upload survives before npm run prune:uploads reclaims it.
PRUNE_GRACE_DAYS="30"
